# Local development only; disable this when deploying to Inngest Cloud.
INNGEST_DEV=1

# Streamlit event submission and run-status API (restart Streamlit after edits).
# INNGEST_DEV_SERVER_URL=http://127.0.0.1:8288

# Local Qdrant storage, relative to the project root (or an absolute path).
QDRANT_PATH=qdrant_storage

# Set a URL to use a Qdrant server instead of local storage.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Needed for ingestion, queries, and written answers (OpenAI API charges apply).
# Not needed to start the app or extract/chunk documents using the helpers.
OPENAI_API_KEY=

# Responses API model for written answers; no embedding reindex is needed to change it.
# OPENAI_ANSWER_MODEL=gpt-5.4-mini

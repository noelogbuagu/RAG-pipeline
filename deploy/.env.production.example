# Copy to deploy/.env.production and fill in every value. That file is ignored by Git.
# Generate each secret on the server so it never passes through chat or email:
#   openssl rand -hex 32        (INNGEST_*, QDRANT_API_KEY, POSTGRES_PASSWORD)
#   openssl rand -base64 32 | tr -- '+/' '-_'   (COOKIE_SECRET)

# Public hostname users will open. Its DNS record must point at this server.
APP_DOMAIN=rag.example.com

# --- Login (OIDC) -----------------------------------------------------------
# Create an OAuth/OIDC client with your identity provider (Google, Microsoft
# Entra ID, Okta, ...) and register this redirect URI: https://<APP_DOMAIN>/oauth2/callback
# Google issuer: https://accounts.google.com
# Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only these email domains may sign in, e.g. example.com (comma-separate several).
ALLOWED_EMAIL_DOMAINS=
COOKIE_SECRET=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_ANSWER_MODEL=gpt-5.4-mini

# --- Internal secrets (never shared outside this server) --------------------
# The signing key must be an even-length hex string.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
QDRANT_API_KEY=
# Hex only: it is embedded in a connection URL.
POSTGRES_PASSWORD=
